# Netlify response headers.
# Fonts never change under the same name → cache for a year.
# Images may be replaced under the same name → cache for a week.
# HTML, CSS, JS and the resume keep Netlify's default (revalidate every
# visit) so a deploy shows up immediately.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/og-image.jpg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon-32.png
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
